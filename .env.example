# All values below are the committed working dev defaults (clean-clone rule:
# everything runs with NO .env at all). Copy to .env only to override.
DCRE_DB_URL=jdbc:postgresql://localhost:26257/dcre_col?sslmode=disable
AGT_DB_URL=jdbc:postgresql://localhost:26257/agt_ops?sslmode=disable
# Single exchange root; the per-client tree exchange/<clientbase>/<channel>/<sub> lives under it.
DCRE_EXCHANGE_ROOT=./exchange
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Slack incoming-webhook URL for the alerting contact point. THERE IS NO WORKING DEFAULT
# and that is deliberate: a placeholder URL validates and brings Grafana up, but it then
# reports as CONFIGURED while delivering nothing, which is the failure shape the alert
# rules exist to remove. So `kubectl apply -k k8s/base` provisions RULES ONLY and a clean
# clone needs nothing here.
#
# Set this, then run the two commands in README "Alerting" to create the Secret and apply
# k8s/overlays/alerting-slack. The value NEVER reaches the repository: it goes into a
# Kubernetes Secret, and the provisioning file references only the variable name.
DCRE_SLACK_WEBHOOK_URL=
